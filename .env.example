# Copy to .env and fill in, or use the app's Setup page.
# .env is gitignored; this file is committed. Secrets only:
# every other setting lives in settings.json (docs/PRD.md FR-14).

# Question generation and translation (OpenAI-compatible API) — required
GEN_AI_API_KEY=
GEN_AI_URL=https://openrouter.ai/api/v1
GEN_AI_MODEL=

# Judge — optional, each value defaults to the generator value.
# Recommended: a different model from the one inside the target system.
JUDGE_AI_API_KEY=
JUDGE_AI_URL=
JUDGE_AI_MODEL=

# Target RAG endpoint — required for the default adapter
RAG_API_KEY=
RAG_URL=
